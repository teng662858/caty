# 运行期数据：含下载到的第三方 bundle，运行后还会写入网盘凭据 —— 绝不提交
host-data/
*.pending

# 探测/抓包产物：可能含源站地址与凭据字段，按需 force-add
fixtures/

# libmpv 播放内核的预编译包（28 个 .xcframework，~200MB，CI 现下）
ios/Frameworks/mpvkit/

# macOS / Xcode
.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Node
node_modules/

# 交付包（给 Mac 的代码包，可随时重新生成）
dist/

# NodeMobile 运行时（100 MB+，CI 会自动下载；不要提交，否则推送会非常慢）
ios/Frameworks/
ios/build/
ios/Caty.xcodeproj/
ios/xcodebuild.log
ios/Caty-unsigned.ipa
ios/Payload/

# ⚠️ workflow 文件不走 git：当前 gh 令牌没有 workflow 权限，推送会被 GitHub 拒绝。
# 仓库里的 .github/workflows/build-ipa.yml 是通过网页界面创建的；本地这份只是留档。
# 若以后给令牌加了 workflow 权限（gh auth refresh -h github.com -s workflow），可以删掉这一行改为纳入版本管理。
.github/workflows/
